{
  "name": "dsh-file-picker",
  "version": "0.2.1",
  "description": "Search for and select local files or directories from the DSH Web GUI for conversation context.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-file-picker": "bin/install.js"
  },
  "files": [
    "bin/install.js",
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check bin/install.js && node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaomingbo/dsh-file-picker.git"
  },
  "homepage": "https://github.com/shaomingbo/dsh-file-picker#readme",
  "bugs": {
    "url": "https://github.com/shaomingbo/dsh-file-picker/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "file-picker",
    "web-gui"
  ],
  "author": "shaomingbo",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
